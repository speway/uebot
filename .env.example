TELEGRAM_BOT_TOKEN=replace_with_bot_token
TELEGRAM_CHAT_ID=replace_with_verified_group_id
CHECK_INTERVAL_SECONDS=300

# На Vercel AI Gateway использует автоматически выданный VERCEL_OIDC_TOKEN.
# Для Docker/обычного сервера задайте OPENAI_API_KEY только в локальном .env.
OPENAI_API_KEY=
AI_MODEL=openai/gpt-5.4-mini
AI_WEB_SEARCH=1
AI_COOLDOWN_SECONDS=10
# Личные сообщения закрыты по умолчанию; перечислите разрешённые Telegram user ID через запятую.
AI_PRIVATE_USER_IDS=
# Не включайте без необходимости: 1 откроет платные AI-ответы всем написавшим в личку.
AI_ALLOW_PRIVATE=0
